    },
    {
      "src": "/assets/logo.jpeg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/logo.jpeg",
      "sizes": "384x512",
      "type": "image/jpeg",
      "form_factor": "wide"
    }
  ]
}
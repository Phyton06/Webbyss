  "description": "PWA para la barbería",
  "start_url": "/login",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#1a1a2e",
  "background_color": "#1a1a2e",
  "display_override": ["window-control-overlay"],
  "icons": [
    {
      "src": "/assets/logo.jpeg",

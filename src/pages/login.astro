---
import BaseHead from '../components/BaseHead.astro';
---

<BaseHead title="BarberShop Login" description="Inicio de sesión para BarberShop" />

<div class="min-h-screen bg-gray-900 flex items-center justify-center p-4">

  <div class="login-card bg-gray-800 rounded-xl w-full max-w-md p-8 shadow-2xl">

    <div class="text-center mb-8">
      <img
        src="/assets/logo.jpeg"
        alt="BarberShop"
        class="w-20 h-20 mx-auto mb-4"
        width="80"
        height="80"
        loading="lazy"
      />
      <h1 class="text-2xl font-bold text-white mb-2">BarberShop</h1>
      <p class="text-gray-400">Bienvenido de nuevo</p>
    </div>

    <form class="space-y-4">
      <div>
        <label for="email" class="block text-sm text-gray-300 mb-2">Correo electrónico</label>
        <input
          type="email"
          id="email"
          class="w-full px-4 py-3 bg-gray-700 rounded border border-gray-600 focus:outline-none focus:border-accent focus:bg-gray-800 text-white"
          placeholder="ejemplo@barbershop.com"
          required
          autocomplete="email"
        />
      </div>

      <div>
        <label for="password" class="block text-sm text-gray-300 mb-2">Contraseña</label>
        <input
          type="password"
          id="password"
          class="w-full px-4 py-3 bg-gray-700 rounded border border-gray-600 focus:outline-none focus:border-accent focus:bg-gray-800 text-white"
          placeholder="Tu contraseña"
          required
          autocomplete="current-password"
        />
      </div>

      <div class="flex items-center justify-between text-sm">
        <button
          type="submit"
          class="w-full bg-accent text-gray-900 font-medium py-3 rounded hover:bg-accent-hover transition-colors"
        >
          Iniciar sesión
        </button>

        <div class="flex items-center text-gray-500">
          <span class="mr-2">o</span>
          <a href="/register" class="font-medium text-accent hover:text-accent-hover">
            Crear cuenta
          </a>
        </div>
      </div>
    </form>
  </div>
</div>
---
import BaseHead from '../components/BaseHead.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
---

<BaseHead
  title="Webby's BarberShop Login"
  description="Inicio de sesión para Webby's BarberShop"
/>

<div class="page">
  <main class="login-card">
    <header class="brand">
      <img
        src={`${import.meta.env.BASE_URL}/assets/logo.jpeg`}
        alt="Webby's BarberShop"
        class="brand-logo"
        width="96"
        height="96"
        loading="eager"
      />
      <h1><span class="brand-pre">Webby's</span> BarberShop</h1>
      <p class="tagline">Bienvenido de nuevo</p>
    </header>

    <!-- ponytail: social buttons are decorative — Supabase auth planned for later, no backend yet -->
    <div class="social">
      <button type="button" class="social-btn" disabled>
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"
          ><path
            fill="#4285F4"
            d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"
          ></path><path
            fill="#34A853"
            d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"
          ></path><path
            fill="#FBBC05"
            d="M3.97 10.72A5.41 5.41 0 0 1 3.69 9c0-.6.1-1.18.28-1.72V4.95H.96A9 9 0 0 0 0 9c0 1.45.35 2.82.96 4.05l3.01-2.33z"
          ></path><path
            fill="#EA4335"
            d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"
          ></path></svg
        >
        Google
      </button>
      <button type="button" class="social-btn" disabled>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="#1877F2" aria-hidden="true"
          ><path
            d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"
          ></path></svg
        >
        Facebook
      </button>
    </div>

    <div class="divider" role="separator"><span>o</span></div>

    <form class="login-form">
      <div class="field">
        <label for="email">Correo electrónico</label>
        <input
          type="email"
          id="email"
          placeholder="ejemplo@barbershop.com"
          required
          autocomplete="email"
        />
      </div>

      <div class="field">
        <label for="password">Contraseña</label>
        <input
          type="password"
          id="password"
          placeholder="Tu contraseña"
          required
          autocomplete="current-password"
        />
      </div>

      <div class="form-row">
        <label class="remember">
          <input type="checkbox" id="remember" />
          <span>Recordarme</span>
        </label>
        <!-- ponytail: no reset flow exists yet — dead link until backend -->
        <a href="#" class="forgot">¿Olvidaste tu contraseña?</a>
      </div>

      <button type="submit" class="submit">Iniciar sesión</button>

      <div class="alt">
        <span class="alt-sep">o</span>
        <!-- ponytail: absolute site-root link, existing project convention; route the site through import.meta.env.BASE_URL if navigation is reworked -->
        <a href="/register">Crear cuenta</a>
      </div>
    </form>
  </main>
  <InstallPrompt />
</div>

<style>
  /* Dark theme is the default (fallback when the device reports nothing). */
  .page {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    font-family: var(--font-atkinson, sans-serif);
    color: #9aa4b8;
    background: #000;
  }

  .login-card {
    width: 100%;
    max-width: 420px;
    padding: 0;
  }

  .brand {
    text-align: center;
    margin-bottom: 1.1rem;
  }

  .brand-logo {
    display: block;
    width: 80px;
    height: 80px;
    margin: 0 auto 0.75rem;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid rgba(212, 175, 106, 0.55);
    box-shadow:
      0 0 0 4px rgba(212, 175, 106, 0.1),
      0 12px 26px rgba(0, 0, 0, 0.45);
  }

  h1 {
    margin: 0 0 0.35rem;
    font-family: var(--font-display, serif);
    font-weight: 700;
    font-size: clamp(2.6rem, 9vw, 3.4rem);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #f2f4f8;
  }

  .brand-pre {
    display: block;
    font-size: 0.36em;
    letter-spacing: 0.42em;
    margin-bottom: 0.45rem;
    color: #d4af6a;
  }

  .tagline {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: #9aa4b8;
  }

  .social {
    display: flex;
    flex-direction: row;
    gap: 0.65rem;
    margin-bottom: 0.95rem;
  }

  .social-btn {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: #171717;
    background: #ffffff;
    border: 1px solid #ffffff;
    border-radius: 10px;
    cursor: not-allowed;
    opacity: 0.85;
  }

  .social-btn:disabled {
    cursor: not-allowed;
  }

  .social-btn:not(:disabled):hover {
    background: #e8e8e8;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.95rem;
    color: #5d6579;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(154, 164, 184, 0.25);
  }

  .field {
    margin-bottom: 0.95rem;
  }

  .field label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9aa4b8;
  }

  .field input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.8rem 0.9rem;
    font-family: inherit;
    font-size: 1rem;
    color: #eef1f6;
    background: #141414;
    border: 1px solid #333333;
    border-radius: 10px;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .field input::placeholder {
    color: #828ca3;
  }

  .field input:hover {
    border-color: #555555;
  }

  .field input:focus-visible {
    outline: none;
    border-color: #d4af6a;
    box-shadow: 0 0 0 3px rgba(212, 175, 106, 0.22);
  }

  .form-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
    font-size: 0.9rem;
  }

  .remember {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
  }

  .remember input {
    width: 1rem;
    height: 1rem;
    accent-color: #d4af6a;
  }

  .forgot {
    color: #d4af6a;
    text-decoration: none;
    border-bottom: 1px solid rgba(212, 175, 106, 0.45);
    padding-bottom: 1px;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .forgot:hover {
    color: #e5c489;
    border-color: #e5c489;
  }

  .forgot:focus-visible {
    outline: 2px solid #d4af6a;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .submit {
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin-top: 0.4rem;
    padding: 0.9rem 1rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #10131c;
    background: #d4af6a;
    border: 1px solid #d4af6a;
    border-radius: 10px;
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .submit:hover {
    background: #e5c489;
    border-color: #e5c489;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(212, 175, 106, 0.28);
  }

  .submit:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .submit:focus-visible {
    outline: 2px solid #e5c489;
    outline-offset: 3px;
  }

  .alt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-size: 0.95rem;
    color: #9aa4b8;
  }

  .alt-sep {
    color: #5d6579;
  }

  .alt a {
    color: #d4af6a;
    text-decoration: none;
    border-bottom: 1px solid rgba(212, 175, 106, 0.45);
    padding-bottom: 1px;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .alt a:hover {
    color: #e5c489;
    border-color: #e5c489;
  }

  .alt a:focus-visible {
    outline: 2px solid #d4af6a;
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Short phones (<=700px tall): compact rhythm so the login never scrolls. */
  @media (max-height: 700px) {
    .page {
      padding: 0.75rem;
    }

    .brand {
      margin-bottom: 0.7rem;
    }

    .brand-logo {
      width: 56px;
      height: 56px;
      margin-bottom: 0.5rem;
    }

    h1 {
      font-size: clamp(2rem, 8vw, 2.6rem);
    }

    .brand-pre {
      margin-bottom: 0.25rem;
    }

    .social,
    .divider,
    .field,
    .form-row {
      margin-bottom: 0.6rem;
    }

    .social-btn {
      padding: 0.6rem 1rem;
    }

    .field input {
      padding: 0.65rem 0.9rem;
    }

    .submit {
      margin-top: 0.2rem;
      padding: 0.75rem 1rem;
    }

    .alt {
      margin-top: 0.6rem;
    }
  }

  /* Never scroll: discrete zoom steps for very short viewports (landscape phones,
     small windows). Compact content ranges 533–558px by width; each tier's worst
     measured content fits from its min covered height up to the next boundary.
     ponytail: media queries can't compute a fit — steps cover down to ~189px tall,
     below that the window is unusable and scrolling is the graceful fallback. */
  @media (max-height: 557px) {
    .login-card {
      zoom: 0.88; /* fits >= 484px */
    }
  }

  @media (max-height: 483px) {
    .login-card {
      zoom: 0.78; /* fits >= 433px */
    }
  }

  @media (max-height: 432px) {
    .login-card {
      zoom: 0.68; /* fits >= 384px */
    }
  }

  @media (max-height: 383px) {
    .login-card {
      zoom: 0.58; /* fits >= 329px */
    }
  }

  @media (max-height: 328px) {
    .login-card {
      zoom: 0.48; /* fits >= 280px */
    }
  }

  @media (max-height: 279px) {
    .login-card {
      zoom: 0.38; /* fits >= 231px */
    }
  }

  @media (max-height: 230px) {
    .login-card {
      zoom: 0.3; /* fits >= 189px */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field input,
    .submit,
    .forgot,
    .alt a {
      transition: none;
    }

    .submit:hover {
      transform: none;
    }
  }

  /* Light theme when the device reports light mode. Gold darkened for AA contrast on white. */
  @media (prefers-color-scheme: light) {
    .page {
      color: #5d6579;
      background: #ffffff;
    }

    .brand-logo {
      border-color: rgba(138, 106, 47, 0.55);
      box-shadow:
        0 0 0 4px rgba(138, 106, 47, 0.12),
        0 12px 26px rgba(23, 27, 38, 0.18);
    }

    h1 {
      color: #171b26;
    }

    .tagline,
    .field label,
    .alt {
      color: #5d6579;
    }

    .social-btn {
      color: #171717;
      background: #ffffff;
      border-color: #d4d4d8;
    }

    .divider {
      color: #828ca3;
    }

    .divider::before,
    .divider::after {
      background: rgba(23, 27, 38, 0.14);
    }

    .field input {
      color: #171b26;
      background: #f4f4f5;
      border-color: #d4d4d8;
    }

    .field input:hover {
      border-color: #a1a1aa;
    }

    .field input:focus-visible {
      border-color: #8a6a2f;
      box-shadow: 0 0 0 3px rgba(138, 106, 47, 0.22);
    }

    .remember input {
      accent-color: #8a6a2f;
    }

    .forgot {
      color: #8a6a2f;
      border-bottom-color: rgba(138, 106, 47, 0.45);
    }

    .forgot:hover {
      color: #6f5524;
      border-color: #6f5524;
    }

    .submit {
      color: #ffffff;
      background: #8a6a2f;
      border-color: #8a6a2f;
    }

    .submit:hover {
      background: #6f5524;
      border-color: #6f5524;
      box-shadow: 0 12px 24px rgba(138, 106, 47, 0.3);
    }

    .submit:focus-visible {
      outline-color: #8a6a2f;
    }

    .alt-sep {
      color: #828ca3;
    }

    .alt a {
      color: #8a6a2f;
      border-bottom-color: rgba(138, 106, 47, 0.45);
    }

    .alt a:hover {
      color: #6f5524;
      border-color: #6f5524;
    }
  }
</style>

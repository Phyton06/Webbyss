---
import BaseHead from '../../components/BaseHead.astro';
import BottomNav from '../../components/BottomNav.astro';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Empleado — Admin | Webby's BarberShop"
      description="Ficha de empleado de Webby's BarberShop"
    />
  </head>
  <body>
    <div class="page">
      <div class="shell">
        <a class="back" href="/Webbyss/admin/empleados">← Personal</a>
        <div id="detail"></div>
      </div>
    </div>

    <BottomNav />

    <script is:inline>
      if (sessionStorage.getItem('webbys_admin') !== '1') {
        location.replace('/Webbyss/login');
      }
    </script>

    <script>
      import {
        seedEmployees,
        getEmployee,
        deactivateEmployee,
        ROLE_NAME,
        ROLE_TOKEN,
        escapeHtml,
      } from '../../scripts/employees.js';

      const detailEl = document.getElementById('detail');
      const id = new URLSearchParams(window.location.search).get('id');

      // Deep links can land here on a fresh browser: seed before the lookup.
      seedEmployees();
      const employee = getEmployee(id);

      const initials = (name) =>
        String(name)
          .trim()
          .split(/\s+/)
          .slice(0, 2)
          .map((part) => part.charAt(0))
          .join('')
          .toUpperCase();

      if (!employee) {
        detailEl.innerHTML = `
          <h1 class="hero-name">No encontramos ese empleado</h1>
          <p class="fallback-text">Revisá el enlace o volvé a la lista del personal.</p>
          <a class="back" href="/Webbyss/admin/empleados">Volver a personal</a>`;
      } else {
        const token = ROLE_TOKEN[employee.role] || ROLE_TOKEN.barbero;
        const digits = String(employee.phone).replace(/\D/g, '');
        const baja = employee.status === 'Baja';
        const statusChip = baja ? '<span class="status-chip">Baja</span>' : '';
        // Deactivate, never hard-delete; reactivating is a later concern.
        const deactivate = baja
          ? ''
          : `<button type="button" class="danger-btn" id="deactivate">Desactivar</button>`;
        const name = escapeHtml(employee.name);
        // Line-art icons, same stroke family as BottomNav (fill:none + currentColor).
        const phoneIcon = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>`;
        // Filled brand mark: a stroke bubble + receiver reads as a hook at 22px
        // (the path carries its own fill/stroke so it wins over `.quick svg`).
        // ponytail: nominative use, linking to WhatsApp itself.
        const chatIcon = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" stroke="none" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>`;

        detailEl.innerHTML = `
          <header class="hero">
            <span class="avatar" style="background:${token}" aria-hidden="true">${escapeHtml(
              initials(employee.name),
            )}</span>
            <h1 class="hero-name">${name}</h1>
            <span class="hero-chips">
              <span class="role-chip">${escapeHtml(
                ROLE_NAME[employee.role] || employee.role,
              )}</span>
              ${statusChip}
            </span>
          </header>

          <div class="quick-actions">
            <a class="quick" href="tel:${escapeHtml(
              employee.phone,
            )}" aria-label="Llamar a ${name}">${phoneIcon}</a>
            <a class="quick" href="https://wa.me/${digits}" aria-label="WhatsApp con ${name}">${chatIcon}</a>
          </div>

          <section class="card">
            <h2 class="card-title">Contacto</h2>
            <dl class="card-list">
              <div class="card-row">
                <dt>Teléfono</dt>
                <dd><a href="tel:${escapeHtml(employee.phone)}">${escapeHtml(employee.phone)}</a></dd>
              </div>
              <div class="card-row">
                <dt>Correo</dt>
                <dd>${escapeHtml(employee.email || '—')}</dd>
              </div>
              <div class="card-row">
                <dt>Ingreso</dt>
                <dd>${escapeHtml(employee.startDate || '—')}</dd>
              </div>
            </dl>
          </section>

          <section class="card">
            <h2 class="card-title">Trabajo</h2>
            <dl class="card-list">
              <div class="card-row">
                <dt>Rol</dt>
                <dd>${escapeHtml(ROLE_NAME[employee.role] || employee.role)}</dd>
              </div>
              <div class="card-row">
                <dt>Estado</dt>
                <dd>${escapeHtml(employee.status)}</dd>
              </div>
              <div class="card-row">
                <dt>Horario</dt>
                <dd>${escapeHtml(employee.schedule || '—')}</dd>
              </div>
            </dl>
          </section>

          <div class="mutations">
            <a class="secondary-btn" href="/Webbyss/admin/nuevo-empleado?id=${encodeURIComponent(
              employee.id,
            )}">Editar</a>
            ${deactivate}
          </div>`;

        const deactivateBtn = document.getElementById('deactivate');
        if (deactivateBtn) {
          deactivateBtn.addEventListener('click', () => {
            deactivateEmployee(employee.id);
            // ponytail: reload instead of a client-side re-render
            location.reload();
          });
        }
      }
    </script>
  </body>
</html>

<style>
  .page {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100dvh;
    padding: var(--space-4);
    font-family: var(--font-atkinson, sans-serif);
    color: var(--color-text);
    background: var(--color-bg);
  }

  .shell {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding-bottom: var(--space-6);
  }

  /* .back is static here but also injected on the unknown-id fallback. */
  :global(.back) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-1);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-accent);
  }

  :global(.back:focus-visible) {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  /* Everything inside #detail is injected via innerHTML → :global. */
  :global(.hero) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 var(--space-4);
    text-align: center;
  }

  :global(.avatar) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    font-family: var(--font-display, serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-white); /* clears 4.5:1 on every role token */
    border-radius: 50%;
  }

  :global(.hero-name) {
    margin: 0;
    font-family: var(--font-display, serif);
    font-weight: 700;
    font-size: clamp(1.7rem, 8vw, 2.2rem);
    line-height: 1.1;
    color: var(--color-heading);
  }

  :global(.hero-chips) {
    display: flex;
    gap: var(--space-2);
  }

  :global(.role-chip),
  :global(.status-chip) {
    padding: 0.2rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  :global(.status-chip) {
    border-style: dashed;
  }

  :global(.quick-actions) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  :global(.quick) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: var(--space-2);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    color: var(--color-accent);
    background: var(--color-accent-glow);
    border: 1px solid var(--color-accent-line);
    border-radius: var(--radius-lg);
  }

  :global(.quick svg) {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global(.quick:focus-visible) {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  :global(.card) {
    box-sizing: border-box;
    margin-bottom: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  :global(.card-title) {
    margin: 0 0 var(--space-2);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  :global(.card-list) {
    margin: 0;
  }

  :global(.card-row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
  }

  :global(.card-row + .card-row) {
    border-top: 1px solid var(--color-border);
  }

  :global(.card-row dt) {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  :global(.card-row dd) {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    text-align: right;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  :global(.card-row dd a) {
    color: inherit;
  }

  /* Mutations live together at the end, thumb-reachable, with real spacing. */
  :global(.mutations) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  :global(.secondary-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: var(--space-3);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    color: var(--color-accent);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  :global(.secondary-btn:focus-visible) {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  :global(.danger-btn) {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: var(--space-3);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  :global(.danger-btn:focus-visible) {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  :global(.fallback-text) {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }

  @media (min-width: 720px) {
    .page {
      padding: var(--space-6) var(--space-4);
    }

    .shell {
      max-width: 720px;
    }
  }
</style>
